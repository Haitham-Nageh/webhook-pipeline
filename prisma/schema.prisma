// ─────────────────────────────────────────────────────────────
// Prisma Schema — Webhook Pipeline Project
//
// Four tables:
//   Pipeline        — stores pipeline configuration and webhook source key
//   Subscriber      — stores delivery target URLs (one pipeline → many subscribers)
//   Job             — stores every incoming webhook as a job with its processing status
//   DeliveryAttempt — stores every delivery try per subscriber with retry tracking
// ─────────────────────────────────────────────────────────────

generator client {
  provider      = "prisma-client-js"
  // Required for running inside Docker on Debian-based Linux images
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ────────────────────────────────────────────────────

// The three available processing actions a pipeline can apply to incoming webhooks
enum ProcessingType {
  metadata_enrichment       // adds processedAt and processedBy fields
  sensitive_field_redaction // replaces sensitive field values with [REDACTED]
  event_annotation          // adds mood, tag, and message based on event type
}

// Tracks the lifecycle of a job from creation to completion
enum JobStatus {
  PENDING    // job created, waiting for the worker to pick it up
  PROCESSING // worker is currently executing the action
  COMPLETED  // action ran and all subscribers received the result
  FAILED     // action failed or all delivery attempts were exhausted
}

enum DeliveryStatus {
  SUCCESS // subscriber responded with a 2xx status code
  FAILED  // request failed or timed out
}

// ─── Models ───────────────────────────────────────────────────

model Pipeline {
  id             String         @id @default(uuid())
  name           String
  // Unique random key used in the webhook URL: POST /webhooks/:sourceKey
  sourceKey      String         @unique
  processingType ProcessingType
  // Optional action-specific settings (e.g. fields to redact, default tag)
  config         Json?
  // Inactive pipelines reject incoming webhooks with 403
  isActive       Boolean        @default(true)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  subscribers    Subscriber[]
  jobs           Job[]
}

model Subscriber {
  id         String   @id @default(uuid())
  pipelineId String
  // The external URL that receives the processed payload after delivery
  targetUrl  String
  createdAt  DateTime @default(now())

  // Cascade delete: removing a pipeline removes all its subscribers
  pipeline         Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  // Index for faster lookups when fetching subscribers by pipeline
  @@index([pipelineId])
}

model Job {
  id               String    @id @default(uuid())
  pipelineId       String
  payload          Json      // original incoming webhook data
  processedPayload Json?     // result after the action runs (null until processed)
  status           JobStatus @default(PENDING)
  errorMessage     String?   // populated if processing or delivery fails
  createdAt        DateTime  @default(now())
  startedAt        DateTime? // set when the worker picks up the job
  completedAt      DateTime? // set when processing and delivery finish
  updatedAt        DateTime  @updatedAt

  // Cascade delete: removing a pipeline removes all its jobs
  pipeline         Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  deliveryAttempts DeliveryAttempt[]

  @@index([pipelineId])
  // Index on status for efficient worker polling (WHERE status = 'PENDING')
  @@index([status])
}

model DeliveryAttempt {
  id             String         @id @default(uuid())
  jobId          String
  subscriberId   String
  attemptNumber  Int            // 1-based retry counter (max 4 attempts)
  status         DeliveryStatus
  responseStatus Int?           // HTTP status code returned by the subscriber
  errorMessage   String?        // network error or timeout message if failed
  attemptedAt    DateTime       @default(now())
  nextRetryAt    DateTime?      // scheduled time for next retry (null after final attempt)

  // Cascade delete: removing a job or subscriber removes its delivery attempts
  job        Job        @relation(fields: [jobId], references: [id], onDelete: Cascade)
  subscriber Subscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([subscriberId])
}